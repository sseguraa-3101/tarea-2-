ue="Mostrar dia, agua y alimento disponibles"><mxGeometry x="213.0" y="842.0" width="326" height="40" as="geometry" /></mxCell><mxCell id="water" parent="1" vertex="1" style="whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=1.4;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;fillColor=#FFFFFF;strokeColor=#475F78;fontColor=#15304D;" value="Leer uso_agua (L)"><mxGeometry x="261.5" y="931.0" width="229" height="40" as="geometry" /></mxCell><mxCell id="vw" parent="1" vertex="1" style="whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=1.4;rhombus;fillColor=#FFFFFF;strokeColor=#475F78;fontColor=#15304D;" value="¿uso_agua es numérico y&#10;0 &lt; uso_agua ≤ agua?"><mxGeometry x="248.5" y="1016.2" width="255" height="93.6" as="geometry" /></mxCell><mxCell id="bw" parent="1" vertex="1" style="whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=1.4;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;fillColor=#FFFFFF;strokeColor=#475F78;fontColor=#15304D;" value="Mostrar «Agua inválida»"><mxGeometry x="641.5" y="1043.0" width="207" height="40" as="geometry" /></mxCell><mxCell id="food" parent="1" vertex="1" style="whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=1.4;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;fillColor=#FFFFFF;strokeColor=#475F78;fontColor=#15304D;" value="Leer uso_alimento (unid.)"><mxGeometry x="262.0" y="1153.0" width="228" height="40" as="geometry" /></mxCell><mxCell id="vf" parent="1" vertex="1" style="whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=1.4;rhombus;fillColor=#FFFFFF;strokeColor=#475F78;fontColor=#15304D;" value="¿uso_alimento es numérico y&#10;0 &lt; uso_alimento ≤ alimento?"><mxGeometry x="221.5" y="1232.2" width="309" height="93.6" as="geometry" /></mxCell><mxCell id="bf" parent="1" vertex="1" style="whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=1.4;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;fillColor=#FFFFFF;strokeColor=#475F78;fontColor=#15304D;" value="Mostrar «Alimento inválido»"><mxGeometry x="629.5" y="1259.0" width="231" height="40" as="geometry" /></mxCell><mxCell id="update" parent="1" vertex="1" style="whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=1.4;rounded=0;fillColor=#FFFFFF;strokeColor=#475F78;fontColor=#15304D;" value="agua = agua − uso_agua&#10;alimento = alimento − uso_alimento&#10;total_agua = total_agua + uso_agua&#10;total_alimento = total_alimento + uso_alimento&#10;completadas = completadas + 1"><mxGeometry x="179.0" y="1382.0" width="394" height="116" as="geometry" /></mxCell><mxCell id="bal" parent="1" vertex="1" style="whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=1.4;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;fillColor=#FFFFFF;strokeColor=#475F78;fontColor=#15304D;" value="Mostrar saldo de agua y alimento"><mxGeometry x="224.0" y="1531.0" width="304" height="40" as="geometry" /></mxCell><mxCell id="stop" parent="1" vertex="1" style="whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=1.4;rhombus;fillColor=#FFFFFF;strokeColor=#475F78;fontColor=#15304D;" value="¿dia &lt; jornadas y&#10;(agua = 0 o alimento = 0)?"><mxGeometry x="240.0" y="1609.2" width="272" height="93.6" as="geometry" /></mxCell><mxCell id="next" parent="1" vertex="1" style="whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=1.4;rounded=0;fillColor=#FFFFFF;strokeColor=#475F78;fontColor=#15304D;" value="dia = siguiente valor de range"><mxGeometry x="247.5" y="1742.0" width="257" height="40" as="g